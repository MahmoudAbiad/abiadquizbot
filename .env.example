# نسخة قالب فقط: أسماء المتغيرات بلا قيم حقيقية. انسخه إلى .env محلياً (غير مرفوع إلى git).
# على Heroku: heroku config:set NAME=value   |   على Docker: --env-file .env

# ---------- أساسية (مطلوبة) ----------
# توكن البوت من BotFather (بدونه البوت لا يشتغل)
BOT_TOKEN=
# معرّف تيليجرام الرقمي للأدمن
ADMIN_ID=
# https://<project-ref>.supabase.co
SUPABASE_URL=
# مفتاح service_role (سر: يتجاوز RLS)
SUPABASE_KEY=
# redis:// أو rediss:// (Upstash). الافتراضي المحلي: redis://localhost:6379
REDIS_URL=

# ---------- وضع التشغيل ----------
# موجود = وضع Webhook (إنتاج) ويصير WEBAPP_PUBLIC_BASE_URL مشتقاً منه تلقائياً.
# فارغ = وضع Polling (تطوير محلي). مثال: https://your-app.example.com (بدون / بالنهاية)
WEBHOOK_URL=
# مطلوب عند وجود WEBHOOK_URL (نص عشوائي طويل)
TELEGRAM_WEBHOOK_SECRET=
# تحدده المنصة عادة (Heroku يعيّنه تلقائياً)؛ WEBHOOK_PORT بديل احتياطي
# PORT=8080

# ---------- الذكاء الاصطناعي ----------
# مفاتيح مفصولة بفاصلة: KEY1,KEY2,KEY3
GEMINI_API_KEYS=
GROQ_API_KEY=
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=us-central1
# محتوى JSON الخاص بـ Service Account كسطر واحد (لا ترفع الملف نفسه)
GOOGLE_VERTEX_SA_KEY_JSON=

# ---------- التخزين (Cloudflare R2) ----------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_AUDIO_BUCKET=audio-upload-bucket
R2_FILE_BUCKET=file-upload-bucket

# ---------- اختيارية ----------
SENTRY_DSN=

# ---------- 💳 الشحن الذاتي (شام كاش + MacroDroid) ----------
# فعّل الميزة بعد الإعداد من لوحة الأدمن: مفاتيح التحكم -> payments_enabled (مطفية افتراضياً)
# سر طويل عشوائي يرسله MacroDroid بالـ header: X-Payment-Secret  (مثلاً: openssl rand -hex 32)
PAYMENT_WEBHOOK_SECRET=
# اختياري: السر الجديد أثناء التدوير (يُقبل مع الحالي)
PAYMENT_WEBHOOK_SECRET_NEXT=
# معرّف مجموعة تيليجرام لإشعارات الدفع وأزرار القبول/الرفض (يبدأ بـ -100). البوت لازم يكون عضواً.
PAYMENT_ADMIN_GROUP_ID=
# اختياري: معرّفات أدمن إضافيين (مفصولة بفواصل) يسمح لهم بأزرار الشحن؛ ADMIN_ID مسموح دائماً
PAYMENT_ADMIN_IDS=
# كود التحويل اليدوي لحساب شام كاش المستلم (يظهر للطالب مع الـ QR)
SHAMCASH_TRANSFER_CODE=
# صورة QR (اختياري). الافتراضي: assets/shamcash_qr.jpg
SHAMCASH_QR_PATH=assets/shamcash_qr.jpg
# سقوف الشحن التلقائي (اختياري؛ الافتراضي 1000 نقطة للطلب و5000 نقطة لكل 24 ساعة). تُعدَّل من Heroku بلا نشر كود:
# heroku config:set PAYMENT_AUTO_DAILY_MAX_POINTS=3000
PAYMENT_AUTO_MAX_POINTS_PER_ORDER=1000
PAYMENT_AUTO_DAILY_MAX_POINTS=5000
